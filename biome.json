{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!test/data"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "globalThis": "Connectors are pure functions: no access to the page or the network.",
                  "Function": "Connectors must not create code at runtime.",
                  "eval": "Connectors must not create code at runtime."
                }
              }
            }
          }
        }
      }
    }
  ]
}
